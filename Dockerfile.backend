# Python 后端 Dockerfile（精简版，镜像约 1.5GB）
FROM python:3.11-slim

# 设置工作目录
WORKDIR /app

# 先装 CPU 版 torch（~180MB），再装其他依赖
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple torch --extra-index-url https://download.pytorch.org/whl/cpu
COPY requirements.txt .
RUN pip install --no-cache-dir --timeout=120 -i https://pypi.tuna.tsinghua.edu.cn/simple -r requirements.txt

# 复制源代码
COPY . .

# 创建非root用户（模型按需下载到 hf_cache 卷，不打包进镜像）
RUN useradd --create-home --shell /bin/bash app \
    && chown -R app:app /app \
    && mkdir -p /home/app/.cache/huggingface \
    && chown -R app:app /home/app
USER app

# 暴露端口
EXPOSE 8000

# 环境变量：HF 镜像加速 + 缓存目录
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/home/app/.cache/huggingface
ENV HF_ENDPOINT=https://hf-mirror.com

# 健康检查（slim镜像无curl，用python requests）
HEALTHCHECK --interval=30s --timeout=30s --start-period=120s --retries=5 \
    CMD python -c "import requests; requests.get('http://localhost:8000/health')"

# 启动命令
CMD ["python", "main.py"]
